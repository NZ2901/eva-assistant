generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Message {
  id        Int      @id @default(autoincrement())

  role      String

  content   String

  createdAt DateTime @default(now())
}

model Memory {
  id        Int      @id @default(autoincrement())

  key       String   @unique

  value     String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}